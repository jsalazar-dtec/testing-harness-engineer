{
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh api user)",
      "Bash(gh api repos/*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(jq:*)",
      "Bash(bats:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git hash-object:*)",
      "Bash(git merge-base:*)",
      "Bash(git blame:*)",
      "Bash(git check-ignore:*)",
      "Bash(./scripts/pipeline.sh:*)",
      "Bash(./scripts/task.sh:*)",
      "Bash(./scripts/verify.sh:*)",
      "Bash(./scripts/doctor.sh:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh issue close:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push*--force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/git_guard.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect_artifacts.sh" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect_artifacts.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/cheap_loop.sh" }
        ]
      }
    ]
  }
}
